# Non-secret deployment defaults. Secrets live only in ~/.config/nedra/runtime.env.
NEDRA_IMAGE=localhost/nedra-app:local
NEDRA_NETWORK=nedra
NEDRA_APP_CONTAINER=nedra-app
NEDRA_DB_CONTAINER=nedra-db
NEDRA_APP_VOLUME=nedra-app-data
NEDRA_DB_VOLUME=nedra-db-data
NEDRA_DB_IMAGE=docker.io/pgvector/pgvector:pg16@sha256:018b4a92e634c3a5715f613dd43497e3d8028ae051be7ba6fd127bcffb0e7957
NEDRA_DB_NAME=nedra
NEDRA_DB_USER=nedra
NEDRA_DB_ALIAS=nedra-db
NEDRA_BACKEND_BIND=127.0.0.1
NEDRA_BACKEND_PORT=18080
NEDRA_DOMAIN=nedra.soloveyka.bond
NEDRA_TUNNEL_NAME=nedra
NEDRA_RUNTIME_DIR=${HOME}/.config/nedra
NEDRA_RUNTIME_ENV=${HOME}/.config/nedra/runtime.env
NEDRA_CLOUDFLARED_CONFIG=${HOME}/.config/nedra/cloudflared-nedra.yml
NEDRA_SECRET_SOURCE=${NEDRA_SECRET_SOURCE:-${HOME}/.omp/agent/.env}
NEDRA_CLOUDFLARED_CERT=${HOME}/.cloudflared/cert.pem