# Скопируй в .env и подставь свою локальную БД. Секреты в репозиторий не коммитим.
# scripts/nedra-e2e.sh этот файл не читает: изолированный прогон генерирует
# свои одноразовые секреты (см. docs/RELEASE-HARDENING.md).
DATABASE_URL=postgresql://user:password@localhost:5432/41l1_n3dra

# AI: по умолчанию OpenCode Go, если задан OPENCODE_API_KEY или AI_API_KEY.
# Явный AI_PROVIDER=opencode-go никогда не берёт legacy-ключ/endpoint.
# AI_PROVIDER=opencode-go
# OPENCODE_API_KEY=
# AI_API_KEY=
# AI_BASE_URL=https://opencode.ai/inference/go/v1
# AI_MODEL=deepseek-v4.1-flash

# Legacy ReformBoss остаётся только для обратной совместимости.
# AI_PROVIDER=reformboss
# REFORMBOSS_API_KEY=

# Local OpenAI-compatible: нужны AI_API_KEY, AI_BASE_URL и AI_MODEL/LLM_MODEL.
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=http://127.0.0.1:8000/v1
# AI_MODEL=your-local-model

# Шифрование секретов сценариев в БД (AES-GCM at rest), base64 ровно 32 байта.
# Сгенерировать: python3 -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
# NEDRA_SECRET_KEY=
# NEDRA_SECRETS_MODE=optional
# optional (по умолчанию): без ключа секреты хранятся открыто, как раньше.
# required: без ключа запись ревизий отказывает; читать конверты можно только с ключом.
