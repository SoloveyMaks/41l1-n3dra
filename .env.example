# AI explanation provider (OpenAI-compatible). Never commit real keys.
# Choose one provider; the key is read from the environment only.
AI_PROVIDER=
# reformboss: https://api.reformboss.com/v1 (default model deepseek-v4.1-flash-1017)
REFORMBOSS_API_KEY=
# wikivibe: https://api.wikivibe.dev/v1 (default model deepseek-v4.1-flash)
WIKIVIBE_GPT_KEY=

# Optional overrides. Empty means provider default.
AI_BASE_URL=
AI_MODEL=
AI_TIMEOUT_SECONDS=30
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0
# Set to 1 only if the gateway explicitly supports response_format=json_object.
AI_JSON_MODE=0

# Optional exact pgvector retrieval (db/optional/003_exact_vector.up.sql).
# Default is off; any failure is reported as typed retrieval=unavailable and
# never fails the scan/report pipeline.
VECTOR_RETRIEVAL_ENABLED=false
VECTOR_RETRIEVAL_DSN=
VECTOR_WORKSPACE_ID=
VECTOR_EMBEDDING_SPEC_ID=

# One approved embedding spec. These values must match the active row in
# embedding_specs and the stored vectors' dimension/metric.
VECTOR_EMBEDDING_MODEL=text-embedding-3-small
VECTOR_EMBEDDING_VERSION=2024-02
VECTOR_EMBEDDING_DIMENSION=1536
VECTOR_EMBEDDING_METRIC=cosine
VECTOR_EMBEDDING_QUERY_PREPARATION_VERSION=1
VECTOR_EMBEDDING_DOCUMENT_PREPARATION_VERSION=1
VECTOR_EMBEDDING_REDACTION_VERSION=1

# OpenAI-compatible embeddings endpoint. The chat provider above has no
# confirmed embedding model in /v1/models, so set this explicitly when
# retrieval is on.
VECTOR_EMBEDDING_BASE_URL=
VECTOR_EMBEDDING_API_KEY=
VECTOR_EMBEDDING_TIMEOUT_SECONDS=15

VECTOR_RETRIEVAL_LIMIT=3
VECTOR_RETRIEVAL_MAX_FINDINGS=3
VECTOR_RETRIEVAL_LANGUAGE=kotlin
VECTOR_RETRIEVAL_FRAMEWORK=spring-boot
# Optional exact ruleId -> rule_family mapping, JSON object.
VECTOR_RULE_FAMILY_MAP={}