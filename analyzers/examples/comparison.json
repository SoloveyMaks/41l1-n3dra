    {
      "id": "A-SAST-05",
      "category": "SAST",
      "class": "object-authorization",
      "path": "src/main/kotlin/lab/repairdesk/repair/RepairTicketReader.kt",
      "line": 10,
      "endLine": 11,
      "status": "correct",
      "reported": {
        "category": "SAST",
        "path": "src/main/kotlin/lab/repairdesk/repair/RepairTicketReader.kt",
        "class": "object-authorization",
        "line": 10,
        "endLine": 11,
        "severity": "HIGH",
        "description": "`read` читает объект по идентификатору из маршрута `GET /api/customer/tickets/{ticketId}`; выбрана owner-колонка `customer_id`, фильтр только по `ticket_id`. Политика: Объект принадлежит владельцу, указанному в owner-колонке. Если маршрут возвращает один объект по идентификатору, переданному клиентом, запрос обязан дополнительно ограничить выборку владельцем из аутентифицированного Principal. Совпадение имени поля с owner-колонкой само по себе доступ не доказывает.",
        "remediation": "Добавить в запрос owner-колонку и значение из `Principal`; чужой и отсутствующий объект должны давать одинаковый ответ."
      }
    }
